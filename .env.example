# Database -------------------------------------------------------------------
# Prisma CLI target (migrations, studio, seed fallback). Always a local SQLite
# file: the CLI's migration engine does not accept libsql:// URLs.
LOCAL_DATABASE_URL="file:./prisma/dev.db"

# Runtime database. Point this at Turso to run the app (and the seed script)
# against the hosted database. Leave empty to use LOCAL_DATABASE_URL.
#   turso db create <name>
#   turso db show <name> --url
#   turso db tokens create <name>
DATABASE_URL=""
DATABASE_TOKEN=""

# Legacy aliases still read by the app and scripts: TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN. When both are set, DATABASE_URL / DATABASE_TOKEN win.

# Auth ------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth. Create credentials at
# https://console.cloud.google.com/apis/credentials and register
# {AUTH_URL}/api/auth/callback/google as an authorized redirect URI.
# Leave empty to disable Google sign-in; email/password still works.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Payments -------------------------------------------------------------------
# Provider adapter switch. See docs/payments.md.
#   stripe  - Stripe hosted Checkout (default)
#   manual  - admin marks orders paid (development / bank transfer)
# Polar is not usable for physical goods; its adapter is a future option only
# for digital products.
PAYMENT_PROVIDER="stripe"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Unused while PAYMENT_PROVIDER is not "polar".
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""

# Email ----------------------------------------------------------------------
# console  - log emails (development, no key needed)
# resend   - Resend API (free tier: 3,000/month, 100/day)
# smtp     - any SMTP server (configure SMTP_URL)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"
EMAIL_REPLY_TO="support@example.com"
SMTP_URL=""

# Seed -----------------------------------------------------------------------
# `bun run db:seed` always upserts the admin when these are set. The password
# must be at least 12 characters. Never commit real values.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Set to "true" only against a disposable database: the seed deletes and
# recreates the demo catalogue from app/testData/products.json.
SEED_PRODUCTS="false"

# Catalogue CSV ----------------------------------------------------------------
# Source for the product import (`bun run products:import` and
# POST /api/admin/products/import): a local path relative to the repo root, or
# an http(s) URL (Vercel Blob storage, a raw GitHub file, a Google Drive direct
# link). See docs/products-csv.md for the column reference.
PRODUCTS_CSV=""

# Public HTTPS URL of this app. Used to build absolute links (payment
# redirects, auth callbacks). In development use a tunnel, e.g.
# https://abc123.trycloudflare.com
PUBLIC_SITE_URL=""

# Protects machine-to-machine admin/automation endpoints only. Humans use
# Auth.js sessions and roles (admin/staff); no browser flow should rely on this
# token.
ADMIN_TOKEN=""
